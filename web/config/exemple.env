# ============================================
# ODP Platform - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# cp config/exemple.env .env

# ============================================
# MySQL Database Configuration
# ============================================
MYSQL_HOST=localhost
MYSQL_USER=root
# If password contains special characters (#, $, etc.), use quotes:
# MYSQL_PASSWORD="your_password_with_#_chars"
MYSQL_PASSWORD=root
MYSQL_DB=odp_platform

# ============================================
# Flask Application Configuration
# ============================================
# Secret key for session encryption (generate a new one for production)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Flask debug mode (True/False)
# Set to False in production
FLASK_DEBUG=True

# ============================================
# Optional: Server Configuration
# ============================================
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5001

